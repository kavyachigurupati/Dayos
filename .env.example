# ── AI models ────────────────────────────────────────────────────────────────

# Claude API — orchestration brain (console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=

# Baseten — response generation (baseten.co → Settings → API Keys)
BASETEN_API_KEY=

# ── Search ────────────────────────────────────────────────────────────────────

# you.com search API (api.you.com → Dashboard)
YDC_API_KEY=

# ── Google Calendar ───────────────────────────────────────────────────────────

# Leave as-is for local development. Change to your Cloud Run URL when deployed.
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# ── Email delivery ────────────────────────────────────────────────────────────

# Your Gmail address — briefing gets sent here every morning
EMAIL_USER=

# ── Server ────────────────────────────────────────────────────────────────────

PORT=3000
