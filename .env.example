# Baseten API key — get from baseten.co/dashboard
BASETEN_API_KEY=your_baseten_api_key_here

# you.com API key — get from you.com/api
YDC_API_KEY=your_you_com_api_key_here

# ElevenLabs API key — get from elevenlabs.io (for voice, coming soon)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Port to run the server on
PORT=3000
