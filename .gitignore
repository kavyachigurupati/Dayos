# API keys and environment variables — never commit these
.env

# Google OAuth credentials and tokens — never commit these
credentials.json
tokens.json

# Local memory — contains personal data, never commit
profile.json

# Planner vault — personal schedule/tasks, Obsidian points here, never commit
Planner/

# Dependencies — reinstalled via npm install
node_modules/

# Mac system files
.DS_Store

# Editor files
.vscode/
.idea/

# Logs
*.log
npm-debug.log*

# Runtime
*.pid
*.seed
